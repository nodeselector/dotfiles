#!/usr/bin/env bash
# Install the Topit release that includes AppleScript automation.
set -euo pipefail

readonly VERSION="0.1.5"
readonly SHA256="eedcdce49650243830f8aca87dc2dc30d5cfa80c91f29c728a4081d7da14e8d6"
readonly URL="https://github.com/lihaoyun6/Topit/releases/download/${VERSION}/Topit_v${VERSION}.dmg"
readonly APP="/Applications/Topit.app"

installed_version=""
if [[ -f "$APP/Contents/Info.plist" ]]; then
  installed_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP/Contents/Info.plist" 2>/dev/null || true)"
fi

if [[ -n "$installed_version" ]] && \
   [[ "$(printf '%s\n' "$VERSION" "$installed_version" | sort -V | head -n 1)" == "$VERSION" ]]; then
  echo "✓ Topit $installed_version already installed"
  exit 0
fi

tmpdir="$(mktemp -d)"
mountpoint="$tmpdir/mount"
dmg="$tmpdir/Topit.dmg"
mounted=false
cleanup() {
  if [[ "$mounted" == true ]]; then
    hdiutil detach "$mountpoint" -quiet 2>/dev/null || true
  fi
  rm -rf "$tmpdir"
}
trap cleanup EXIT

mkdir -p "$mountpoint"
curl --fail --location --retry 3 --silent --show-error "$URL" --output "$dmg"
echo "$SHA256  $dmg" | shasum -a 256 --check --status
hdiutil attach "$dmg" -nobrowse -readonly -mountpoint "$mountpoint" -quiet
mounted=true
codesign --verify --deep --strict "$mountpoint/Topit.app"

pkill -x Topit 2>/dev/null || true
rm -rf "$APP"
ditto "$mountpoint/Topit.app" "$APP"

echo "✓ Installed Topit $VERSION"
